# pilih: firestore (Firebase) | sheets (Google Spreadsheet)
DB_DRIVER=firestore
JWT_SECRET=ganti-dengan-string-acak-panjang
APP_URL=http://localhost:3000

# --- Metode 2: Google Spreadsheet ---
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Metode 1: Firebase Firestore (Project settings > Service accounts > Generate new private key) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Pengingat tenggat: panggil GET /api/cron/reminders dengan header Authorization: Bearer <CRON_SECRET> ---
CRON_SECRET=

# --- Email lupa password (opsional; kosong = link tampil di layar saat dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
